# =============================================================================
# ReproForge Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env

# ---------------------------------------------------------------------------
# LLM Providers (used by the P1 reader; not used by the P0 core)
# ---------------------------------------------------------------------------
# OpenAI / OpenAI-compatible (DeepSeek, Qwen, vLLM, Ollama, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# For Ollama:      OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_MODEL=llama3
# For vLLM:        OPENAI_BASE_URL=http://localhost:8000/v1

# Native DeepSeek variables are detected automatically by the CLI.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---------------------------------------------------------------------------
# External APIs (reserved for later paper/code discovery integrations)
# ---------------------------------------------------------------------------
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Memory & Vector Storage (P5 planned; not consumed by P0/P1)
# ---------------------------------------------------------------------------
# Required only when starting the corresponding future Compose service.
# Use a reviewed immutable digest for production, for example image@sha256:...
CHROMA_IMAGE=
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=repro_forge

# ---------------------------------------------------------------------------
# Knowledge Graph (P5 planned; not consumed by P0/P1)
# ---------------------------------------------------------------------------
NEO4J_IMAGE=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Required before `docker compose -f compose.future.yml up`.
NEO4J_PASSWORD=

# ---------------------------------------------------------------------------
# Experiment Execution (P3 planned; no execution backend exists yet)
# ---------------------------------------------------------------------------
# P3 planned backends: dryrun | local-subprocess | docker
EXECUTION_BACKEND=dryrun
# Deferred remote backends; these variables do not imply adapter support.
SSH_HOST=
SSH_USER=
SSH_KEY_PATH=
COLAB_CREDENTIALS=
VASTAI_API_KEY=

# MLflow tracking (P3 planned)
MLFLOW_TRACKING_URI=./mlruns

# ---------------------------------------------------------------------------
# Observability (P8 planned)
# ---------------------------------------------------------------------------
JAEGER_IMAGE=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# API Server (P6 planned; no FastAPI app exists yet)
# ---------------------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_WORKERS=1
ENABLE_CORS=false
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Evaluation (P8 planned)
# ---------------------------------------------------------------------------
EVALUATION_MODEL=gpt-4o
EVALUATION_MAX_TASKS=10
