# =============================================================================
# ReproForge Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env

# ---------------------------------------------------------------------------
# LLM Providers (at least one required)
# ---------------------------------------------------------------------------
# OpenAI / OpenAI-compatible (DeepSeek, Qwen, vLLM, Ollama, etc.)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# For DeepSeek:    OPENAI_BASE_URL=https://api.deepseek.com
# For Ollama:      OPENAI_BASE_URL=http://localhost:11434/v1   MODEL=llama3
# For vLLM:        OPENAI_BASE_URL=http://localhost:8000/v1

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---------------------------------------------------------------------------
# External APIs
# ---------------------------------------------------------------------------
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Memory & Vector Storage
# ---------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=repro_forge

# ---------------------------------------------------------------------------
# Knowledge Graph (Neo4j)
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ---------------------------------------------------------------------------
# Experiment Execution
# ---------------------------------------------------------------------------
# Backend: dryrun | docker | colab | ssh | vastai
EXECUTION_BACKEND=dryrun
SSH_HOST=
SSH_USER=
SSH_KEY_PATH=
COLAB_CREDENTIALS=
VASTAI_API_KEY=

# MLflow tracking
MLFLOW_TRACKING_URI=./mlruns

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# API Server
# ---------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4
ENABLE_CORS=true
ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# Evaluation
# ---------------------------------------------------------------------------
EVALUATION_MODEL=gpt-4o
EVALUATION_MAX_TASKS=10
