title: "ReproForge: Automated Paper Reading & Reproduction for CS Research"
authors:
  - name: "ReproForge Contributors"
url: "https://github.com/selfrestart/26Summer/tree/main/repro-forge"
license: Apache-2.0
version: 0.1.0
date-released: 2025-07-24
